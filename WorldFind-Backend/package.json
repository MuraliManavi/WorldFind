{
  "name": "worldfind-backend",
  "version": "1.0.0",
  "description": "Backend API for WorldFind India-focused shopping application integrating with AliExpress Open Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
