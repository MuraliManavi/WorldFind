# WorldFind Backend Environment Configuration

# Server Configuration
PORT=8080
NODE_ENV=development
WORLD_FIND_API_BASE_URL=https://worldfind.onrender.com

# CORS Configuration (comma-separated origins for production)
CORS_ORIGIN=*

# Firebase Admin Credentials (REQUIRED in production)
FIREBASE_PROJECT_ID=worldfind-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@worldfind-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# AliExpress Open Platform Credentials (REQUIRED in production)
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here
ALIEXPRESS_API_BASE_URL=https://api-sg.aliexpress.com/sync
ALIEXPRESS_OAUTH_URL=https://oauth.aliexpress.com/authorize

# AliExpress OAuth Redirect Callback URL
ALIEXPRESS_CALLBACK_URL=https://worldfind.onrender.com/api/aliexpress/callback

# Static Tokens for Local Development Fallback
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=

# Token Encryption Key (REQUIRED in production: 64 hexadecimal characters or strong string)
TOKEN_ENCRYPTION_KEY=GENERATE_A_RANDOM_64_HEX_CHARACTER_SECRET

# Administrative API Key (REQUIRED in production to protect /api/aliexpress/token-status & /refresh-token)
ADMIN_API_KEY=GENERATE_AN_ADMIN_API_KEY_HERE

# WorldFind Default Shopping Target Settings
DEFAULT_SHIP_TO_COUNTRY=IN
DEFAULT_TARGET_CURRENCY=INR
DEFAULT_TARGET_LANGUAGE=EN
DEFAULT_TRACKING_ID=worldfind_default
